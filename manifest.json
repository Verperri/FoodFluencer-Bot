{
  "manifest_version": 3,
  "name": "FoodFluencer Bot",
  "version": "2.0.0",
  "description": "Find and export top restaurant photos in Belgium. Auto-post to Instagram, Facebook & TikTok.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://places.googleapis.com/*",
    "https://itunes.apple.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://www.tiktok.com/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
